{
  "name": "lexiplay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "pnpm --filter @lexiplay/api db:migrate && node apps/api/dist/main.js",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "cefr:build": "node scripts/build-cefr-pools.mjs",
    "cefr:audit-families": "node scripts/audit-cefr-families.mjs",
    "cefr:build-families": "node scripts/build-cefr-families.mjs",
    "cefr:expand-c2": "node scripts/expand-c2.mjs",
    "db:migrate:local": "node scripts/migrate-local-collections.mjs",
    "db:restructure": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/restructure-database.ts",
    "library:publish": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/publish-library.ts",
    "dictionary:inflections": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/supplement-inflections.ts"
  }
}
