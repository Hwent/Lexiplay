{
  "name": "lexiplay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node apps/api/dist/main.js",
    "build": "pnpm --recursive --if-present build",
