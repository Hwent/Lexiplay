{
  "name": "@lexiplay/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "2.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dictionary:seed": "tsx src/modules/word-lists/seed-simple-wiktionary.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && node ../../scripts/prepare-test-database.mjs && vitest run --exclude dist/** --maxWorkers=1",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  }
}
