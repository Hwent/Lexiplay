generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AccountUser {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String
  passwordHash String @map("password_hash")
  email String? @db.VarChar(254)
  emailVerified Boolean @default(false) @map("email_verified")
  coinBalance Int @default(100) @map("coin_balance")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamptz @map("updated_at")
  sessions AccountSession[]
  actions AccountAction[]
  claimedGuests GuestSession[]
  transfers ProgressTransfer[]
  words UserWord[]
  collections UserVocabularyCollection[]
  games PracticeGame[] @relation("GameOwner")
  paidGames PracticeGame[] @relation("GamePayer")
  messages Message[]
  animalGames AnimalGuessGame[]
  @@map("account_users")
}

model AccountSession {
  tokenHash String @id @db.Char(64) @map("token_hash")
  userId String @db.Uuid @map("user_id")
  user AccountUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  @@index([userId])
  @@map("account_sessions")
}

model AccountAction {
  tokenHash String @id @db.Char(64) @map("token_hash")
  userId String @db.Uuid @map("user_id")
  user AccountUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  purpose String
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  @@unique([userId,purpose])
  @@map("account_actions")
}

model GuestSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @db.Char(64) @map("token_hash")
  coinBalance Int @default(10) @map("coin_balance")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  claimedAt DateTime? @db.Timestamptz @map("claimed_at")
  claimedByUserId String? @db.Uuid @map("claimed_by_user_id")
  claimedBy AccountUser? @relation(fields:[claimedByUserId], references:[id], onDelete:SetNull)
  transfers ProgressTransfer[]
  games PracticeGame[] @relation("GuestGameOwner")
  paidGames PracticeGame[] @relation("GuestGamePayer")
  messages Message[]
  animalGames AnimalGuessGame[]
  @@index([claimedByUserId])
  @@map("guest_sessions")
}

model Message {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String? @db.Uuid @map("user_id")
  user AccountUser? @relation(fields:[userId], references:[id], onDelete:Cascade)
  guestSessionId String? @db.Uuid @map("guest_session_id")
  guest GuestSession? @relation(fields:[guestSessionId], references:[id], onDelete:Cascade)
  content String @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  @@index([userId])
  @@index([guestSessionId])
  @@index([createdAt])
  @@map("message")
}

model ProgressTransfer {
  id String @id @db.Uuid
  userId String @db.Uuid @map("user_id")
  user AccountUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  guestSessionId String? @db.Uuid @map("guest_session_id")
  guest GuestSession? @relation(fields:[guestSessionId], references:[id], onDelete:Restrict)
  payloadHash String @db.Char(64) @map("payload_hash")
  result Json
  completedAt DateTime @default(now()) @db.Timestamptz @map("completed_at")
  @@index([userId])
  @@index([guestSessionId])
  @@map("progress_transfers")
}

model LibraryState {
  id Int @id @default(1) @db.SmallInt
  version String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  @@map("library_state")
}

model WordFamily {
  id String @id
  headword String
  band Int? @db.SmallInt
  sourceMetadata Json @default("{}") @map("source_metadata")
  entries DictionaryEntry[]
  @@map("word_families")
}

model DictionaryEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  term String
  partOfSpeech String @map("part_of_speech")
  familyId String? @map("family_id")
  family WordFamily? @relation(fields:[familyId], references:[id], onDelete:SetNull)
  sourceMetadata Json @default("{}") @map("source_metadata")
  definitions DictionaryDefinition[]
  collections CollectionEntry[]
  personalEntries UserWord[]
  inflections DictionaryInflection[] @relation("InflectionBase")
  baseForms DictionaryInflection[] @relation("InflectionForm")
  thesaurusSenses ThesaurusSense[]
  @@unique([term,partOfSpeech])
  @@index([familyId])
  @@map("dictionary_entries")
}

model DictionaryInflection {
  baseEntryId String @db.Uuid @map("base_entry_id")
  formEntryId String @db.Uuid @map("form_entry_id")
  kind String
  source String
  sourceRef String @map("source_ref")
  baseEntry DictionaryEntry @relation("InflectionBase", fields:[baseEntryId], references:[id], onDelete:Cascade)
  formEntry DictionaryEntry @relation("InflectionForm", fields:[formEntryId], references:[id], onDelete:Cascade)
  @@id([baseEntryId,formEntryId,kind])
  @@index([formEntryId], map: "dictionary_inflections_form_entry_idx")
  @@map("dictionary_inflections")
}

model DictionaryDefinition {
  languageCode String @default("en") @map("language_code")
  dictionaryEntryId String @db.Uuid @map("dictionary_entry_id")
  entry DictionaryEntry @relation(fields:[dictionaryEntryId], references:[id], onDelete:Cascade)
  senseOrder Int @map("sense_order")
  definition String
  sourceLabel String? @map("source_label")
  @@id([dictionaryEntryId,languageCode,senseOrder])
  @@map("dictionary_definitions")
}

model ThesaurusSense {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source String
  sourceEntryId String @map("source_entry_id")
  senseKey String @map("sense_key")
  term String
  partOfSpeech String @map("part_of_speech")
  definition String
  metadata Json @default("{}")
  dictionaryEntryId String? @db.Uuid @map("dictionary_entry_id")
  entry DictionaryEntry? @relation(fields:[dictionaryEntryId], references:[id], onDelete:SetNull)
  relations ThesaurusRelation[]
  @@unique([source,sourceEntryId,senseKey])
  @@index([term])
  @@index([dictionaryEntryId])
  @@map("thesaurus_senses")
}

model ThesaurusRelation {
  senseId String @db.Uuid @map("sense_id")
  targetTerm String @map("target_term")
  kind String
  sourceList String @map("source_list")
  groupOrder Int @map("group_order")
  sortOrder Int @map("sort_order")
  metadata Json @default("{}")
  sense ThesaurusSense @relation(fields:[senseId], references:[id], onDelete:Cascade)
  @@id([senseId,kind,targetTerm])
  @@index([targetTerm])
  @@map("thesaurus_relations")
}

model VocabularyCollection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique
  name String
  description String @default("")
  category String
  author String?
  sourceName String? @map("source_name")
  sourceVersion String? @map("source_version")
  sourceUrl String? @map("source_url")
  license String?
  status String @default("available")
  hidden Boolean @default(false)
  entries CollectionEntry[]
  savedBy UserVocabularyCollection[]
  games PracticeGame[]
  @@map("vocabulary_collections")
}

model CollectionEntry {
  collectionId String @db.Uuid @map("collection_id")
  dictionaryEntryId String @db.Uuid @map("dictionary_entry_id")
  collection VocabularyCollection @relation(fields:[collectionId], references:[id], onDelete:Cascade)
  entry DictionaryEntry @relation(fields:[dictionaryEntryId], references:[id], onDelete:Restrict)
  stage String @default("Core")
  sortOrder Int @map("sort_order")
  @@id([collectionId,dictionaryEntryId])
  @@index([collectionId,sortOrder,dictionaryEntryId])
  @@index([dictionaryEntryId])
  @@map("collection_entries")
}

model UserVocabularyCollection {
  userId String @db.Uuid @map("user_id")
  user AccountUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  collectionId String @db.Uuid @map("collection_id")
  collection VocabularyCollection @relation(fields:[collectionId], references:[id], onDelete:Restrict)
  savedAt DateTime @default(now()) @db.Timestamptz @map("saved_at")
  @@id([userId,collectionId])
  @@index([collectionId])
  @@map("user_vocabulary_collections")
}

model UserWord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user AccountUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  dictionaryEntryId String @db.Uuid @map("dictionary_entry_id")
  entry DictionaryEntry @relation(fields:[dictionaryEntryId], references:[id], onDelete:Restrict)
  status String @default("active")
  familiarity Int @default(0) @db.SmallInt
  stage String @default("Core")
  nextReviewAt DateTime? @db.Timestamptz @map("next_review_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamptz @map("updated_at")
  @@unique([userId,dictionaryEntryId])
  @@index([userId,status,createdAt,id])
  @@index([dictionaryEntryId])
  @@map("user_words")
}

model PracticeGame {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startRequestId String @unique @db.Uuid @map("start_request_id")
  userId String? @db.Uuid @map("user_id")
  user AccountUser? @relation("GameOwner", fields:[userId], references:[id], onDelete:Cascade)
  guestSessionId String? @db.Uuid @map("guest_session_id")
  guest GuestSession? @relation("GuestGameOwner", fields:[guestSessionId], references:[id], onDelete:Cascade)
  coinUserId String? @db.Uuid @map("coin_user_id")
  coinUser AccountUser? @relation("GamePayer", fields:[coinUserId], references:[id], onDelete:NoAction)
  coinGuestSessionId String? @db.Uuid @map("coin_guest_session_id")
  coinGuest GuestSession? @relation("GuestGamePayer", fields:[coinGuestSessionId], references:[id], onDelete:Restrict)
  answer String
  collectionId String? @db.Uuid @map("collection_id")
  collection VocabularyCollection? @relation(fields:[collectionId], references:[id], onDelete:Restrict)
  difficulty String
  attemptCount Int @default(0) @db.SmallInt @map("attempt_count")
  coinChange Int @map("coin_change")
  activeState Json? @map("active_state")
    ladderState Json? @map("ladder_state")
  status String @default("active")
  gaveUp Boolean @default(false) @map("gave_up")
  finishedAt DateTime? @db.Timestamptz @map("finished_at")
  @@index([userId,finishedAt])
  @@index([guestSessionId])
  @@index([coinUserId])
  @@index([coinGuestSessionId])
  @@index([collectionId])
  @@map("practice_games")
}

model AnimalGuessGame {
  id String @id @db.Uuid
  userId String? @db.Uuid @map("user_id")
  user AccountUser? @relation(fields:[userId], references:[id], onDelete:Cascade)
  guestSessionId String? @db.Uuid @map("guest_session_id")
  guest GuestSession? @relation(fields:[guestSessionId], references:[id], onDelete:Cascade)
  status String
  questionCount Int @db.SmallInt @map("question_count")
  guessCount Int @db.SmallInt @map("guess_count")
  finishedAt DateTime @db.Timestamptz @map("finished_at")
  @@index([userId,finishedAt], map:"animal_guess_games_user_finished_idx")
  @@index([guestSessionId], map:"animal_guess_games_guest_idx")
  @@map("animal_guess_games")
}
