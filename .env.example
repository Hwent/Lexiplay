# Copy these placeholders to the private root .env; never commit secrets.
NODE_ENV=development
PORT=3000
# Production binds 0.0.0.0; development defaults to loopback.
# HOST=0.0.0.0
# Production serves apps/web/dist from the same API origin.
# SERVE_WEB=true
# Render uses a reverse proxy. Set 1 there; direct/local servers default to 0.
# TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://lexiplay:lexiplay@localhost:5432/lexiplay?schema=public
# Production dump/import tools use this external Render connection.
SEED_DATABASE_URL=
# Database redeployment source and replacement target.
REDEPLOY_PRODUCTION_URL=
REDEPLOY_TARGET_URL=
WEB_ORIGIN=http://localhost:5173
# pnpm dev sets PUBLIC_WEB_ORIGIN to its selected web URL unless overridden.
# Leave unset locally so pnpm dev uses its actual selected port.
# PUBLIC_WEB_ORIGIN=https://your-deployed-frontend.example
# On Render, RENDER_EXTERNAL_URL is used if PUBLIC_WEB_ORIGIN is unset.
# local writes development-only messages to apps/api/.local-mail (gitignored).
# Production requires resend, HTTPS origin, a verified sender, and an API key.
MAIL_MODE=local
MAIL_FROM="LexiPlay <onboarding@resend.dev>"
RESEND_API_KEY=
# Merriam-Webster Collegiate Dictionary; server-side maintenance only.
DICTIONARYAPI1=
# Collegiate Thesaurus; synonym and antonym database imports.
DICTIONARYAPI2=
# Optional additional keys with provider-approved quota; select explicitly with --key-env.
DICTIONARYAPI3=
DICTIONARYAPI4=
